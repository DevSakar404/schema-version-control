# Supabase Postgres connection string.
#
# Supabase dashboard -> Connect -> Connection string -> URI, and take the
# TRANSACTION POOLER entry (port 6543). Not the direct connection: it is
# IPv6-only on the free tier and Vercel cannot route to it (see D41).
#
# Optional for the core test suite — the pure src/core/ tests need no
# database, and the database-backed tests skip themselves when this is unset.
DATABASE_URL=
